    <graphicData>
      <texPath>Things/Plant/Olive</texPath>
      <graphicClass>Graphic_Random</graphicClass>
        <shadowData>
          <volume>(0.15, 0.3, 0.15)</volume>
          <offset>(0,0,-0.38)</offset>
        </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <statBases>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
      <Nutrition>1.5</Nutrition>
    </statBases>
    <minifiedDef IsNull="True" />
    <ingestible />
    <plant>
      <growDays>10</growDays>
      <visualSizeRange>1~2.5</visualSizeRange>
      
      <topWindExposure>0.15</topWindExposure>
      <harvestWork>350</harvestWork>
      <harvestTag>Standard</harvestTag>
      <forceIsTree>true</forceIsTree>
      <harvestYield>8</harvestYield>
      <harvestedThingDef>ITL_RawOlive</harvestedThingDef>
    </plant>
  </ThingDef>
