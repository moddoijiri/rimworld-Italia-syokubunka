  <!--菌類-->
  <ThingDef ParentName="ITL_FungusPlant">
        
        <defName>ITL_PlantYamadoritakemodoki</defName>
        <label>ヤマドリタケモドキ</label>
        <description>日陰で育つ茸。</description>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <Nutrition>0.18</Nutrition>
        </statBases>
        <graphicData>
            <texPath>Things/Plant/Yamadoritakemodoki</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <selectable>true</selectable>
        <pathCost>10</pathCost>
        <ingestible/>
        <plant>
            <fertilitySensitivity>0.4</fertilitySensitivity>
            <fertilityMin>0.1</fertilityMin>
            <maxMeshCount>4</maxMeshCount>
            <dieIfLeafless>true</dieIfLeafless>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>ITL_RawYamadoritakemodoki</harvestedThingDef>
            <harvestAfterGrowth>0.20</harvestAfterGrowth>
            <harvestYield>4</harvestYield>
            <sowMinSkill>6</sowMinSkill>
            <sowTags>
                <li>Ground</li>
            </sowTags>
            <topWindExposure>0.1</topWindExposure>
            <growDays>11.2</growDays>
            <visualSizeRange>0.5~0.8</visualSizeRange>
            <wildOrder>2</wildOrder>
            <purpose>Food</purpose>
            <neverBlightable>true</neverBlightable>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <diesToLight>true</diesToLight>
      <wildEqualLocalDistribution>false</wildEqualLocalDistribution>
        </plant>
    </ThingDef>
	<!--木-->
	<ThingDef ParentName="ITL_FruitTree">
    <defName>Plant_TreeOlive</defName>
    <label>オリーブの木</label>
