    <label>ティラミス</label>
    <description>エスプレッソをしみ込ませたビスケットの上にカスタードとマスカルポーネチーズのクリームを重ねてココアパウダーをかけたドルチェ。</description>
    <graphicData>
      <texPath>Things/Item/Meal/Tiramisu</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>25</MarketValue>
      <WorkToMake>350</WorkToMake>
	  <Nutrition>0.7</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealLavish</preferability>
      <tasteThought>AteLavishMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-75</optimalityOffsetFeedingAnimals>
    </ingestible>
  </ThingDef>
