<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorkGiverDef[defName="SBK_Hakkou"]/fixedBillGiverDefs</xpath>
    <value>
      <li>ITL_Nyuuseihinseizoujyo</li>
      <li>ITL_Pancettatana</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SBK_Jyouzoutaru"] /comps/li[@Class="ProcessorFramework.CompProperties_Processor"] /processes</xpath>
    <value>
      <li>WineJyouzou</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <ThingDef ParentName="SBK_MealBase_Rottable">
    <defName>SBK_Jyagabata</defName>
    <label>じゃがバター</label>
    <description>蒸かしたじゃがいもに塩をふってバターをのせたもの。</description>
    <graphicData>
      <texPath>Things/Item/Meal/Jyagabata</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>44</MarketValue>
      <WorkToMake>450</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealLavish</preferability>
      <tasteThought>AteLavishMeal</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-100</optimalityOffsetFeedingAnimals>
    </ingestible>
  </ThingDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="CookRyouriBase">
    <defName>CookJyagabata</defName>
    <label>じゃがバターを作る</label>
    <description>じゃがバターを作る</description>
    <jobString>じゃがバターを作っている</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <!-- 材料 -->
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawPotatoes</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ITL_Butter</li>
          </thingDefs>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SBK_Shio</li>
          </thingDefs>
        </filter>
        <count>0.25</count>
      </li>
    </ingredients>
    <!-- 使える素材 -->
    <fixedIngredientFilter>
      <thingDefs>
        <li>RawPotatoes</li>
        <li>ITL_Butter</li>
        <li>SBK_Shio</li>
      </thingDefs>
    </fixedIngredientFilter>
    <!-- 完成品 -->
    <products>
      <SBK_Jyagabata>6</SBK_Jyagabata>
      
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <ProcessorFramework.ProcessDef>
        <defName>WineJyouzou</defName>
        <thingDef>ITL_Wine</thingDef>
        <ingredientFilter>
          <thingDefs>
            <li>ITL_RawBudou</li>
          </thingDefs>
        </ingredientFilter>
        <processDays>10</processDays>
        <capacityFactor>2.0</capacityFactor>
        <efficiency>0.4</efficiency>
        <usesTemperature>true</usesTemperature>
        <temperatureSafe>1.0~25.0</temperatureSafe>
        <temperatureIdeal>6.0~15.0</temperatureIdeal>
        <ruinedPerDegreePerHour>2.5</ruinedPerDegreePerHour>
        <speedBelowSafe>0.1</speedBelowSafe>
        <speedAboveSafe>1.0</speedAboveSafe>
        <sunFactor>1.0~1.0</sunFactor>
        <rainFactor>1.0~1.0</rainFactor>
        <snowFactor>1.0~1.0</snowFactor>
        <windFactor>1.0~1.0</windFactor>
        <unpoweredFactor>0.0</unpoweredFactor>
        <unfueledFactor>0.0</unfueledFactor>
        <powerUseFactor>1.0</powerUseFactor>
        <fuelUseFactor>1.0</fuelUseFactor>
        <usesQuality>false</usesQuality>
        <qualityDays>(1, 2, 3, 4, 5, 6, 7)</qualityDays>
        <color>(255, 255, 255)</color>
        <destroyChance>0.0</destroyChance>
      </ProcessorFramework.ProcessDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookKatsuotataki"] /ingredients</xpath>
    <value>
      <ingredients>
        <li>
          <filter>
            <thingDefs>
              <li>SBK_KatsuoFillet</li>
            </thingDefs>
          </filter>
          <count>1.5</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>SBK_Syouyu</li>
            </thingDefs>
          </filter>
          <count>0.25</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>ITL_RawNinniku</li>
            </thingDefs>
          </filter>
          <count>0.25</count>
        </li>
      </ingredients>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookKatsuotataki"] /fixedIngredientFilter</xpath>
    <value>
      <fixedIngredientFilter>
        <thingDefs>
          <li>SBK_KatsuoFillet</li>
          <li>SBK_Syouyu</li>
          <li>ITL_RawNinniku</li>
        </thingDefs>
      </fixedIngredientFilter>
    </value>
  </Operation>
</Patch>
